# Frontend env vars (must be prefixed with VITE_ to be exposed)
# Leave empty to use same-origin (Cloudflare Pages Functions)
VITE_API_BASE_URL=""

# In npm run dev, mock mode is automatic when VITE_API_BASE_URL is empty.
# Set to "false" to force the real backend, or "true" to force mock mode.
#
# Mock mode ships demo administrator accounts (see src/lib/mockApi.ts):
#   admin@l33d.test     / l33d-dev-password   (ACTIVE)
#   suspended@l33d.test / l33d-dev-password   (SUSPENDED)
#   disabled@l33d.test  / l33d-dev-password   (DISABLED)
# These exist only in browser memory and grant no access to any deployment.
VITE_USE_MOCK_API="false"
