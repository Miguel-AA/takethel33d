# Local secrets for `wrangler pages dev`. Copy to `.dev.vars` (gitignored)
# and fill in the values. These are NOT used in production — set the same
# names in the Cloudflare dashboard as secrets.
#
# NOTE: MANAGER_PASSWORD was removed. Administrative access no longer uses a
# shared password — each administrator has an individual account in the
# `admin_users` table. Create one with:
#
#   npm run bootstrap:admin -- --email you@example.com --name "Your Name"
#
# See README.md → "Acceso administrativo".

RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxx"

# Signing key for the public form-session token (phase 9).
#
# The public event page mints a short-lived HMAC token that binds a submission
# to the exact form version the participant was shown. WITHOUT THIS BINDING the
# server cannot tell which questions somebody was actually asked, so the flow
# refuses to serve or accept anything when the key is absent: the event reports
# PUBLIC_EVENT_UNAVAILABLE rather than falling back to an unsigned token or a
# built-in default. There is deliberately no fallback secret anywhere in the
# code.
#
# Generate a fresh one per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
#
# Local development only. In production set it as a Cloudflare secret:
#   npx wrangler pages secret put PUBLIC_FORM_TOKEN_SECRET
PUBLIC_FORM_TOKEN_SECRET=
